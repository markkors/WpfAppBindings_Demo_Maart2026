<Window x:Class="WpfAppBindings.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfAppBindings"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel>
            <Button Height="100"
                    Margin="10"
                    Content="HitMe"
                    Click="Button_Click" />
            <Label x:Name="lblContent" Content="{Binding PersonsLoaded, FallbackValue=0}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="36"></Label>
        </StackPanel>

        <StackPanel Orientation="Vertical"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="10">

            <ComboBox x:Name="cbxPersons"
                      Width="200"
                      Margin="10"
                      DisplayMemberPath="name"
                      SelectedValuePath="id"
                      ItemsSource="{Binding Persons}"
                      SelectedItem="{Binding SelectedPerson}"/>

            
            <Label Content="{Binding SelectedPerson.name}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="24" />
            <Label Content="{Binding SelectedPerson.age}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="24" />
        </StackPanel>


    </Grid>
</Window>
